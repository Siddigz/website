---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/looks/crisp.css';
import '../styles/looks/warm.css';
import '../styles/looks/editorial.css';
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import LookSwitcher from '../components/LookSwitcher.astro';
import { DEFAULT_LOOK, LOOKS, LOOK_PARAM, LOOK_STORAGE_KEY } from '../lib/look';

interface Props {
  title: string;
  description: string;
  /** Path of this page, used for the canonical address. */
  path: string;
  /** Keep the page out of search results (test-only pages). */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang="en" data-look={DEFAULT_LOOK}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply a stored theme choice before first paint. Nothing else belongs here.
      try {
        var stored = localStorage.getItem('color-scheme');
        if (stored === 'light' || stored === 'dark') {
          document.querySelector('meta[name="color-scheme"]').content = stored;
        }
      } catch (error) {}
    </script>
    <script is:inline define:vars={{ looks: LOOKS, param: LOOK_PARAM, key: LOOK_STORAGE_KEY }}>
      // Stage 2 preview: apply the chosen look before first paint. The address
      // wins over the stored choice, and is then remembered for the next page.
      var named = new URLSearchParams(location.search).get(param);
      var stored = null;
      try {
        if (looks.includes(named)) localStorage.setItem(key, named);
        else stored = localStorage.getItem(key);
      } catch (error) {}
      var look = looks.includes(named) ? named : looks.includes(stored) ? stored : null;
      if (look) document.documentElement.dataset.look = look;
    </script>
    {/* Self-hosted fonts. Only the default look's text font is fetched early. */}
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-bricolage" />
    <Font cssVariable="--font-figtree" />
    <Font cssVariable="--font-fraunces" />
    <Font cssVariable="--font-plex-sans" />
    <Font cssVariable="--font-plex-mono" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <LookSwitcher />
  </body>
</html>

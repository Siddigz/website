---
import '../styles/tokens.css';
import '../styles/base.css';
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import CommandMenu from '../components/CommandMenu.astro';
import tokens from '../styles/tokens.css?raw';
import { declaredValue, toHex } from '../lib/colour';
import pageTransition from '../scripts/page-transition.js?raw';

interface Props {
  title: string;
  description: string;
  /** Path of this page, used for the canonical address. */
  path: string;
  /** Keep the page out of search results (test-only pages). */
  noindex?: boolean;
  /**
   * The id of an element near the top of the page. When the browser animates
   * from the page before, it waits until this element is there to animate to.
   */
  expect?: string;
}

const { title, description, path, noindex = false, expect } = Astro.props;
// Not yet in the HTML types, so passed as a plain set of attributes.
const blocking = { blocking: 'render' } as const;
const canonical = new URL(path, Astro.site);

// The browser's own bar (mostly on phones) takes the page background, read
// from the design tokens so the two can never drift apart.
const barColour = {
  light: toHex(declaredValue(tokens, '--color-bg-light')),
  dark: toHex(declaredValue(tokens, '--color-bg-dark')),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={barColour.light} media="(prefers-color-scheme: light)" data-bar="light" />
    <meta name="theme-color" content={barColour.dark} media="(prefers-color-scheme: dark)" data-bar="dark" />
    <script is:inline>
      // Apply a stored theme choice before first paint. Nothing else belongs here.
      try {
        var stored = localStorage.getItem('color-scheme');
        if (stored === 'light' || stored === 'dark') {
          document.querySelector('meta[name="color-scheme"]').content = stored;
          // The browser-bar colour follows the pinned theme, not the system.
          document.querySelectorAll('meta[data-bar]').forEach(function (bar) {
            bar.media = bar.dataset.bar === stored ? 'all' : 'not all';
          });
        }
      } catch (error) {}
    </script>
    {/* Self-hosted fonts, both fetched early: the name at the top and the text under it. */}
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-figtree" preload />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {expect && <link rel="expect" href={`#${expect}`} {...blocking} />}
    {/* Listening before the first draw, for the animation between a project's card and its page. */}
    <script is:inline set:html={pageTransition} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <CommandMenu />
    <script>
      // The greeting from the visitor's clock, and the marks on projects they have opened.
      import '../scripts/visitor';
    </script>
  </body>
</html>

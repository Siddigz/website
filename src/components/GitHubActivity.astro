---
import type { Activity } from '../lib/github-activity';
import { monthLabels } from '../lib/github-activity';
import { formatDay } from '../lib/dates';

interface Props {
  /** Fetched while the site was built. The page leaves this section out when there is none. */
  activity: Activity;
}

const { activity } = Astro.props;
const total = `${activity.total.toLocaleString('en-US')} contributions in the last year`;
const months = new Map(monthLabels(activity.weeks).map(({ week, label }) => [week, label]));
// A year that starts midweek: empty squares keep the first days on their own rows.
const lead = Array.from({ length: 7 - (activity.weeks[0]?.length ?? 7) });
const LEVELS = [0, 1, 2, 3, 4];
---

<section id="activity" class="section container">
  <h2 class="section-title">GitHub activity</h2>
  <div class="panel">
    <div class="graph">
      <p class="total" id="activity-total">{total}</p>
      <div class="months muted" aria-hidden="true">
        {activity.weeks.map((_, week) => <span>{months.get(week)}</span>)}
      </div>
      {/* One picture to a screen reader, named by the line above it. */}
      <div class="days" role="img" aria-labelledby="activity-total" data-days>
        {
          activity.weeks.map((week, index) => (
            <div class="week">
              {index === 0 && lead.map(() => <span class="blank" />)}
              {week.map((day) => (
                <span data-level={day.level} />
              ))}
            </div>
          ))
        }
      </div>
      <p class="key muted" aria-hidden="true">
        Less
        {LEVELS.map((level) => <span data-level={level} />)}
        More
      </p>
    </div>
    {
      activity.commits.length > 0 && (
        <div class="commits">
          <h3>Recent commits</h3>
          <ul role="list">
            {activity.commits.map((commit) => (
              <li>
                <a href={commit.url}>{commit.message}</a>
                <span class="muted">
                  <span translate="no">{commit.repo}</span> · {formatDay(commit.date)}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .panel {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .graph {
    display: grid;
    gap: var(--space-2);
    min-inline-size: 0;
    /* The month names hide when the grid gets too narrow to give them room. */
    container-type: inline-size;
  }

  .total {
    margin-block-end: var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-heading);
    line-height: var(--leading-tight);
  }

  /* One column per week. The squares take whatever width there is, so the
     whole year always fits and the page never scrolls sideways. */
  .months,
  .days {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--heat-gap);
  }

  .months {
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
  }

  .months span {
    white-space: nowrap;
  }

  .week {
    display: grid;
    grid-template-rows: repeat(7, auto);
    gap: var(--heat-gap);
    align-content: start;
  }

  [data-level],
  .blank {
    display: block;
    aspect-ratio: 1;
    border-radius: var(--radius-heat);
  }

  [data-level='0'] {
    background: var(--color-heat-0);
  }

  [data-level='1'] {
    background: var(--color-heat-1);
  }

  [data-level='2'] {
    background: var(--color-heat-2);
  }

  [data-level='3'] {
    background: var(--color-heat-3);
  }

  [data-level='4'] {
    background: var(--color-heat-4);
  }

  .key {
    display: flex;
    align-items: center;
    justify-content: end;
    gap: var(--space-1);
    margin-block-start: var(--space-2);
    font-size: var(--text-sm);
  }

  .key [data-level] {
    inline-size: var(--space-3);
  }

  h3 {
    margin-block-end: var(--space-3);
    font-size: var(--text-base);
  }

  ul {
    display: grid;
    gap: var(--space-3);
  }

  li {
    display: grid;
    min-inline-size: 0;
  }

  .commits {
    min-inline-size: 0;
  }

  /* One line each, cut with an ellipsis, so five commits stay about as tall as the year beside them. */
  li a {
    overflow: hidden;
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-decoration-color: var(--color-border);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  li a:hover {
    text-decoration-color: var(--color-accent);
  }

  li > span {
    overflow: hidden;
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @container (max-width: 28rem) {
    .months {
      display: none;
    }
  }

  /* Side by side when there is room: the year on the left, the commits beside it. */
  @media (min-width: 62rem) {
    .panel {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>

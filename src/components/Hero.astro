---
import { Image } from 'astro:assets';
import { getSite } from '../lib/site';
import { longestGreeting } from '../lib/greeting';
import { resumeEnabled } from '../lib/resume';
import NameButtons from './NameButtons.astro';
import EmailReveal from './EmailReveal.astro';

interface Props {
  /** Test-only: force the looking-for line on or off regardless of site.yaml. */
  lookingForOverride?: boolean;
  /** Test-only: false shows the placeholder figure even when site.yaml has a photo. */
  photoOverride?: boolean;
  /** Test-only: show the Resume link whatever the host's switch says. */
  resumeOverride?: boolean;
  /** Test-only: switch the name's sound on whatever site.yaml says. */
  nameAudioOverride?: boolean;
}

const site = await getSite();
const nameAudio = Astro.props.nameAudioOverride ?? site.name.audio.enabled;
const showLookingFor = Astro.props.lookingForOverride ?? site.lookingFor.enabled;
const photo = (Astro.props.photoOverride ?? true) ? site.photo : undefined;
// Read while the site is built: the link appears with the next build after the switch is turned on.
const showResume = Astro.props.resumeOverride ?? resumeEnabled(process.env);
---

<section id="top" class="hero section container">
  <div class="text" data-hero-text>
    <h1 translate="no">
      {/* With the sound switched on, each word is a button that plays a recording. Otherwise the name is plain text. */}
      {
        nameAudio ? (
          <NameButtons />
        ) : (
          <Fragment>
            <span data-name-part="first">{site.name.first}</span> <span data-name-part="last">{site.name.last}</span>
          </Fragment>
        )
      }
    </h1>
    <p class="pitch">{site.pitch}</p>
    {showLookingFor && <p class="looking-for" data-looking-for>{site.lookingFor.text}</p>}
    <p class="facts muted">
      <span data-program>{site.program}</span><br />
      <span class="fact"><span data-school>{site.school}</span> ·</span>{' '}
      <span class="fact">GPA {site.gpa} ·</span>{' '}
      <span class="fact">Expected {site.expectedGraduation}</span>
    </p>
    {/*
      The neutral line is what the page is built with. The visitor's browser swaps
      in a greeting from their own clock. The second, invisible line is the longest
      greeting there is: it holds the room, so the swap never moves the buttons.
    */}
    <p class="greeting muted">
      <span data-greeting data-words={JSON.stringify(site.greeting)} data-city={site.home.city} data-zone={site.home.timeZone}>{site.greeting.neutral}</span>
      <span class="sizer" aria-hidden="true">{longestGreeting(site.greeting, site.home.city)}</span>
    </p>
    <ul class="links" role="list">
      {site.profileLinks.map((link) => <li><a class="button" href={link.href}>{link.label}</a></li>)}
      {/* Opens beside the site, so the visitor does not lose their place. */}
      {showResume && <li><a class="button" href="/resume.pdf" target="_blank" rel="noopener">{site.resumeLabel}</a></li>}
      {/* Last in the row: when it widens into the address, nothing after it has to move. */}
      <li><EmailReveal /></li>
    </ul>
  </div>
  {/* The photo from site.yaml. Without one, a generic figure: decorative, so hidden from screen readers. */}
  <div class="photo" data-photo-slot>
    {
      photo ? (
        // At the top of the page, so it loads first and never lazily.
        <Image src={photo.src} alt={photo.alt} width={448} height={448} fit="cover" priority />
      ) : (
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <rect class="frame" width="120" height="120" rx="14" />
          <circle class="figure" cx="60" cy="46" r="20" />
          <path class="figure" d="M20 120c1-27 18-42 40-42s39 15 40 42z" />
        </svg>
      )
    }
  </div>
  {/* Read out on each word of the name. Hidden, and outside the heading and the text column so it takes no place in either. */}
  {nameAudio && <p id="name-audio-hint" hidden>{site.name.audio.hint}</p>}
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    padding-block: var(--space-7);
  }

  /* The photo sits above the text on narrow screens and beside it on wide ones. */
  .photo {
    order: -1;
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1fr auto;
      padding-block: var(--space-8) var(--space-7);
    }

    .photo {
      order: 2;
    }
  }

  .photo svg,
  .photo :global(img) {
    inline-size: var(--avatar-size);
    block-size: var(--avatar-size);
  }

  /* Above the text the photo spans the column, up to a limit so it never towers on a small tablet. */
  .photo :global(img) {
    inline-size: 100%;
    max-inline-size: var(--avatar-size-narrow);
    block-size: auto;
    aspect-ratio: 1;
    /* A thick frame, set a little crooked. */
    border: var(--photo-edge) solid var(--color-surface);
    border-radius: var(--radius-photo);
    box-shadow: var(--shadow-photo);
    object-fit: cover;
    rotate: var(--tilt-photo);
  }

  /* The photo straightens and grows a touch when pointed at. */
  @media (prefers-reduced-motion: no-preference) {
    .photo :global(img) {
      transition:
        rotate var(--duration-base) var(--ease-spring),
        scale var(--duration-base) var(--ease-spring);
    }

    .photo :global(img:hover) {
      rotate: var(--tilt-photo-hover);
      scale: var(--scale-photo-hover);
    }
  }

  @media (min-width: 48rem) {
    .photo :global(img) {
      inline-size: var(--avatar-size);
    }
  }

  .frame {
    fill: var(--color-surface);
    stroke: var(--color-border);
  }

  .figure {
    fill: var(--color-border);
  }

  /* Each fact stays whole: "Carleton University" never splits across lines. */
  .fact {
    white-space: nowrap;
  }

  .text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-inline-size: var(--measure);
  }

  .pitch {
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .looking-for {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-tint-a);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  /* A small green light. It pings three times when the page opens, then rests. */
  .looking-for::before {
    content: '';
    inline-size: var(--space-2);
    block-size: var(--space-2);
    border-radius: 50%;
    background: var(--color-live);
  }

  @media (prefers-reduced-motion: no-preference) {
    .looking-for::before {
      animation: live-ping var(--duration-ping) var(--ease-out) 3;
    }
  }

  @keyframes live-ping {
    from {
      box-shadow: 0 0 0 0 var(--color-live-ring);
    }

    to {
      box-shadow: 0 0 0 var(--live-ping-reach) transparent;
    }
  }

  .facts,
  .greeting {
    font-size: var(--text-sm);
  }

  /* Both lines share one place, and the invisible one sets its height. */
  .greeting {
    display: grid;
  }

  .greeting > * {
    grid-area: 1 / 1;
  }

  .sizer {
    visibility: hidden;
    user-select: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

</style>

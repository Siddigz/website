---
import { getEntry } from 'astro:content';

const { items } = (await getEntry('skills', 'main'))!.data;
---

<!--
  A strip that scrolls sideways on its own. CSS only.
  Without motion (reduced motion set) it is a plain wrapped list.
  With motion, a second copy of the list makes the loop seamless; that copy
  is hidden from assistive technology.
-->
<section id="skills" class="skills">
  <h2 class="visually-hidden">Skills</h2>
  <div class="strip">
    <div class="viewport container">
      <div class="track" data-track>
        <ul aria-label="Skills" role="list">
          {items.map((skill) => <li>{skill}</li>)}
        </ul>
        <ul class="copy" aria-hidden="true" role="list">
          {items.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
    </div>
    <label class="pause container">
      <input type="checkbox" aria-label="Pause the skills strip" />
      <span>Pause</span>
    </label>
  </div>
</section>

<style>
  .skills {
    padding-block: var(--space-4);
  }

  .track,
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* Static by default: no second copy and nothing to pause. */
  .copy,
  .pause {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Clip the moving track so it can never widen the page. */
    .viewport {
      overflow: clip;
    }

    .track {
      flex-wrap: nowrap;
      gap: 0;
      inline-size: max-content;
      animation: marquee var(--duration-marquee) linear infinite;
    }

    ul {
      flex-wrap: nowrap;
      padding-inline-end: var(--space-5);
    }

    .copy {
      display: flex;
    }

    .pause {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin-block-start: var(--space-2);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }

    .strip:hover .track,
    .strip:focus-within .track,
    .strip:has(.pause input:checked) .track {
      animation-play-state: paused;
    }
  }

  /* The track holds two identical lists, so half its width is one full loop. */
  @keyframes marquee {
    to {
      translate: -50% 0;
    }
  }
</style>

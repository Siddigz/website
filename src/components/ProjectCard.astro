---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { id, data } = Astro.props.project;
---

<article class="card">
  {
    data.cover && (
      <Image
        class="cover"
        src={data.cover}
        alt={data.coverAlt ?? ''}
        width={800}
        height={500}
        fit="cover"
        position="left top"
      />
    )
  }
  <div class="body">
    {
      data.award && (
        <p class="award">
          {data.award.name} · {data.award.event}
        </p>
      )
    }
    <h3><a href={`/projects/${id}`}>{data.title}</a></h3>
    <p class="muted">{data.oneLiner}</p>
    {data.result && <p class="result">{data.result}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    align-content: start;
    overflow: clip;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-accent);
  }

  .cover {
    inline-size: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: left top;
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  h3 {
    font-size: var(--text-xl);
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The whole card is the link target; the title stays the accessible name. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .award {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .result {
    font-weight: var(--weight-medium);
  }
</style>

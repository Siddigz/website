---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { id, data } = Astro.props.project;
const contain = data.coverFit === 'contain';
---

<article class="card">
  {
    data.cover && contain && (
      /* Charts and screenshots: the whole image, never cropped. */
      <Image class="cover contain" src={data.cover} alt={data.coverAlt ?? ''} width={800} sizes="(min-width: 48rem) 34rem, 100vw" />
    )
  }
  {
    data.cover && !contain && (
      /* Photos: cropped to fill the frame. */
      <Image
        class="cover"
        src={data.cover}
        alt={data.coverAlt ?? ''}
        width={800}
        height={500}
        fit="cover"
        position={data.coverPosition}
        sizes="(min-width: 48rem) 34rem, 100vw"
      />
    )
  }
  <div class="body">
    {
      data.award && (
        <p class="award">
          {data.award.name} · {data.award.event}
        </p>
      )
    }
    <h3><a href={`/projects/${id}`}>{data.title}</a></h3>
    <p class="muted">{data.oneLiner}</p>
    {data.result && <p class="result">{data.result}</p>}
    <ul class="stack muted" role="list" aria-label="Built with" translate="no">
      {data.stack.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</article>

<script>
  // Tells each card where the mouse is, so a look can light or tilt it.
  // Values are fractions of the card: 0 to 1 across, and -1 to 1 from the centre.
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    for (const card of document.querySelectorAll<HTMLElement>('.card')) {
      let frame = 0;
      card.addEventListener('pointermove', (event) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const box = card.getBoundingClientRect();
          const x = (event.clientX - box.left) / box.width;
          const y = (event.clientY - box.top) / box.height;
          card.style.setProperty('--pointer-x', `${(x * 100).toFixed(1)}%`);
          card.style.setProperty('--pointer-y', `${(y * 100).toFixed(1)}%`);
          card.style.setProperty('--pointer-dx', (x * 2 - 1).toFixed(3));
          card.style.setProperty('--pointer-dy', (y * 2 - 1).toFixed(3));
        });
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--pointer-dx', '0');
        card.style.setProperty('--pointer-dy', '0');
      });
    }
  }
</script>

<style>
  .card {
    position: relative;
    display: grid;
    align-content: start;
    overflow: clip;
    border: var(--border-width) solid var(--color-card-border);
    border-radius: var(--radius-card);
    background: var(--color-card-bg);
    box-shadow: var(--shadow-card);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-card-border-hover);
    box-shadow: var(--shadow-card-hover);
  }

  /* A look may lift the card on hover. Movement only for visitors who allow it. */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        border-color var(--duration-fast) var(--ease-out),
        box-shadow var(--duration-base) var(--ease-out),
        translate var(--duration-base) var(--ease-spring),
        rotate var(--duration-base) var(--ease-spring);
    }

    .card:hover,
    .card:focus-within {
      translate: 0 calc(var(--lift-card) * -1);
    }
  }

  .cover {
    inline-size: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: left top;
    border-block-end: var(--border-width) solid var(--color-border);
  }

  .cover.contain {
    padding: var(--space-3);
    object-fit: contain;
    object-position: center;
    background: var(--color-bg);
  }

  .body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  h3 {
    font-size: var(--text-xl);
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* The whole card is the link target; the title stays the accessible name. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .award {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .result {
    font-style: var(--style-result);
    font-weight: var(--weight-medium);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin-block-start: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    letter-spacing: var(--tracking-label);
    text-transform: var(--transform-label);
  }
</style>

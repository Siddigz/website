---
// "One packet, hop by hop": the route from top to bottom with the packet beside
// the stop it is at, the packet's headers, and a history table. The page is
// built showing the first stop, with the whole journey already in the table;
// the script (src/scripts/explainers/packet.ts) steps through it. Data and
// sentences come from src/lib/explainers/packet.ts.
import { DELIVERED, HOPS, LAST_STEP, ROUTE_LABEL, VERDICT, changeLine, historyRows, longestStepLine, stateAt, stepLine, stretchOf, type Kind } from '../../lib/explainers/packet';

const start = stateAt(0);
const rows = historyRows(LAST_STEP);
// Every caption is laid out, unseen, in the caption's box: the box is as tall as the longest, so nothing below it moves.
const captions = [...new Set(HOPS.map((hop) => hop.caption))];
const longestStep = longestStepLine();

// A small drawing for each kind of device, in a 24 by 24 box.
const GLYPHS: Record<Kind, string> = {
  laptop: '<rect x="5" y="6" width="14" height="9" rx="1.5"/><path d="M3 18.5h18"/>',
  router: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v9M7.5 12h9"/>',
  modem: '<rect x="4.5" y="7" width="15" height="10" rx="2"/><circle cx="12" cy="12" r="1.5"/>',
  amplifier: '<path d="M5.5 7h13L12 18z"/>',
  switch: '<rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M6 13h1.5M9.5 13H11M13 13h1.5M16.5 13H18"/>',
  server: '<rect x="6.5" y="3" width="11" height="18" rx="1.5"/><path d="M9.5 8h5M9.5 12h5"/>',
};
---

<div class="packet" data-packet>
  {/* What is said about the packet: on a wide screen this stays in view beside the route. */}
  <div class="side">
    <div class="caption-box">
      {/* Read out when it changes, so a screen reader follows the packet too. */}
      <p class="caption" role="status" data-caption>
        <span class="step" data-step>{stepLine(0)}</span>
        <span data-caption-text>{HOPS[0]!.caption}</span>
      </p>
      {
        captions.map((caption) => (
          <p class="caption sizer" aria-hidden="true">
            <span class="step">{longestStep}</span>
            <span>{caption}</span>
          </p>
        ))
      }
    </div>

    <div class="controls">
      <button type="button" data-previous aria-disabled="true">Previous</button>
      <button type="button" class="main" data-next>Next hop</button>
      <button type="button" data-reset>Reset</button>
      <span class="info muted" data-info data-delivered={DELIVERED}></span>
    </div>

    <div class="bar">
      <div class="seg eth" data-seg="eth">
        <span class="label">Ethernet header</span>
        <span>dst MAC <span class="v" data-f="eDst">{start.eDst}</span> src MAC <span class="v" data-f="eSrc">{start.eSrc}</span></span>
      </div>
      <div class="seg ip" data-seg="ip">
        <span class="label">IP header</span>
        <span>
          dst IP <span class="v" data-f="ipDst">{start.ipDst}</span> src IP <span class="v" data-f="ipSrc">{start.ipSrc}</span> TTL <span class="v" data-f="ttl">{start.ttl}</span>
        </span>
      </div>
      <div class="seg tcp">
        <span class="label">TCP header</span>
        <span>dst port <span class="v" data-f="port">{start.port}</span></span>
      </div>
      <div class="seg dat">
        <span class="label">Data</span>
        <span>your web request (payload)</span>
      </div>
    </div>

    <p class="changed" data-changed-line>{changeLine(0)}</p>
    <p class="verdict" data-verdict hidden>{VERDICT}</p>
  </div>

  {/* The path, top to bottom. Real text, so it reads at any width; the packet glides down beside it. */}
  <ol class="route" role="list" aria-label={ROUTE_LABEL} data-route>
    {
      HOPS.map((hop, index) => {
        const stretch = stretchOf(index);
        const inFiber = stretch?.tone === 'fiber';
        return (
          <li
            class:list={[
              'stop',
              hop.kind,
              stretch?.tone,
              { first: stretch?.from === index, last: stretch?.to === index, 'fiber-in': inFiber && index > stretch.from, 'fiber-out': inFiber && index < stretch.to },
            ]}
            data-stop
            aria-current={index === 0 ? 'step' : undefined}
          >
            {
              index === 0 && (
                <span class="token" data-token aria-hidden="true">
                  <span class="layers">
                    <span class="eth" />
                    <span class="ip" />
                    <span class="tcp" />
                    <span class="dat" />
                  </span>
                  <span class="token-label">packet</span>
                </span>
              )
            }
            <span class="mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={GLYPHS[hop.kind]} />
            </span>
            {stretch?.from === index && <span class="stretch">{stretch.label}</span>}
            <span class="text">
              <span class="name">{hop.name}</span>
              {hop.detail.map((line) => <span class="detail">{line}</span>)}
            </span>
          </li>
        );
      })
    }
  </ol>

  <div class="cards">
    <div class="card eth">
      <h2>Ethernet</h2>
      <div class="field">
        <span class="fname">dst MAC</span>
        <span class="fval" data-f="eDst">{start.eDst}</span>
        <span class="note strong">only reaches the next router</span>
      </div>
      <div class="field">
        <span class="fname">src MAC</span>
        <span class="fval" data-f="eSrc">{start.eSrc}</span>
      </div>
    </div>
    <div class="card ip">
      <h2>IP</h2>
      <div class="field">
        <span class="fname">dst IP</span>
        <span class="fval" data-f="ipDst">{start.ipDst}</span>
        <span class="note strong">never changes end to end</span>
      </div>
      <div class="field">
        <span class="fname">src IP</span>
        <span class="fval" data-f="ipSrc">{start.ipSrc}</span>
        <span class="note" data-nat hidden>NAT: home router swaps in your public IP — the destination IP is never touched.</span>
      </div>
      <div class="field">
        <span class="fname">TTL (hops left)</span>
        <span class="fval" data-f="ttl">{start.ttl}</span>
        <span class="note">−1 at each router</span>
      </div>
    </div>
    <div class="card tcp">
      <h2>TCP</h2>
      <div class="field">
        <span class="fname">dst port</span>
        <span class="fval" data-f="port">{start.port}</span>
        <span class="note">443 = HTTPS</span>
      </div>
    </div>
    <div class="card dat">
      <h2>Data</h2>
      <div class="field">
        <span class="fname">payload</span>
        <span class="fval">web request</span>
        <span class="note">never touched by any network device</span>
      </div>
    </div>
  </div>


  <div class="history">
  <h2 class="history-title" id="packet-history">History: one row per hop</h2>
  {/* On a narrow screen the table scrolls inside this box, which the keyboard can reach. */}
  <div class="table-scroll" role="group" aria-labelledby="packet-history" tabindex="0">
  <table>
    <thead>
      <tr><th scope="col">Link</th><th scope="col">dst MAC</th><th scope="col">src MAC</th><th scope="col">dst IP</th><th scope="col">TTL</th></tr>
    </thead>
    <tbody>
      {/* Every row is here from the start. The script shows them as the packet reaches each stop; without scripts they all show. */}
      {
        rows.map((row, index) => (
          <tr hidden={index > 0} data-current={index === 0 ? '' : undefined}>
            <td>{row.link}</td>
            <td class="m">{row.eDst}</td>
            <td class="m">{row.eSrc}</td>
            <td class="m">{row.ipDst}</td>
            <td class="m">{row.ttl}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>
  </div>
</div>

<script>
  import '../../scripts/explainers/packet';
</script>

<style>
  .packet {
    display: grid;
    gap: var(--space-4);
    min-inline-size: 0;
  }

  /* Each layer of the packet has one colour everywhere: the drawing, the bar and the cards. */
  .eth {
    --layer: var(--color-layer-eth);
  }

  .ip {
    --layer: var(--color-layer-ip);
  }

  .tcp {
    --layer: var(--color-layer-tcp);
  }

  .dat {
    --layer: var(--color-layer-data);
  }

  .side,
  .history {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    min-inline-size: 0;
  }

  /* From a tablet up, the route stands on the left and what is said about the packet is beside it. */
  @media (min-width: 48rem) {
    .packet {
      grid-template-columns: minmax(0, min(var(--route-width), var(--route-share))) minmax(0, 1fr);
      column-gap: var(--space-6);
    }

    .route {
      grid-area: 1 / 1;
    }

    .side {
      grid-area: 1 / 2;
      align-self: start;
    }

    .cards,
    .history {
      grid-column: 1 / -1;
    }
  }

  /* Where the screen is tall enough to hold it, that side stays put while the route scrolls past. */
  @media (min-width: 48rem) and (min-height: 40rem) {
    .side {
      position: sticky;
      inset-block-start: var(--sticky-top);
    }
  }

  /* The caption and its unseen copies share one cell, so the box is always as tall as the longest. */
  .caption-box {
    display: grid;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .caption {
    display: grid;
    grid-area: 1 / 1;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
  }

  .sizer {
    visibility: hidden;
  }

  .step {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
  }

  .route {
    display: grid;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* One stop: room for the packet, the stop's drawing on the line, then its words. */
  .stop {
    --stop-pad: var(--space-2);
    --rail-at: calc(var(--space-3) + var(--packet-width) + var(--space-3) + var(--route-mark) / 2);
    --mark-at: calc(var(--stop-pad) + var(--route-mark) / 2);

    position: relative;
    display: grid;
    grid-template-columns: var(--packet-width) var(--route-mark) minmax(0, 1fr);
    column-gap: var(--space-3);
    align-items: start;
    padding: var(--stop-pad) var(--space-3);
  }

  /* The two local networks and the long fiber are shaded bands. */
  .stop.home {
    background: var(--color-tint-a);
  }

  .stop.fiber {
    background: var(--color-tint-c);
  }

  .stop.dc {
    background: var(--color-tint-b);
  }

  /* The first stop of a band carries the band's name on a line of its own, above the stop. */
  .stop.first {
    --mark-at: calc(var(--stop-pad) + var(--route-label) + var(--route-mark) / 2);

    border-start-start-radius: var(--radius-md);
    border-start-end-radius: var(--radius-md);
  }

  .stop.last {
    border-end-start-radius: var(--radius-md);
    border-end-end-radius: var(--radius-md);
  }

  /* The line between stops: one piece from the stop above, one to the stop below. */
  .stop::before,
  .stop::after {
    content: '';
    position: absolute;
    inset-inline-start: calc(var(--rail-at) - var(--rail) / 2);
    inline-size: var(--rail);
    background: var(--color-text-muted);

    --rail: var(--rail-width);
  }

  .stop::before {
    inset-block-start: 0;
    block-size: var(--mark-at);
  }

  .stop::after {
    inset-block: var(--mark-at) 0;
  }

  .stop:first-child::before,
  .stop:last-child::after {
    content: none;
  }

  /* The fiber itself: thicker, and the colour of light. */
  .stop.fiber-in::before,
  .stop.fiber-out::after {
    --rail: var(--rail-width-fiber);

    background: var(--color-amber);
  }

  .stretch {
    grid-area: 1 / 3;
    display: flex;
    align-items: center;
    block-size: var(--route-label);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    white-space: nowrap;
  }

  .stop.first > :is(.token, .mark, .text) {
    grid-row: 2;
  }

  .mark {
    position: relative;
    z-index: 1;
    grid-column: 2;
    display: block;
    block-size: var(--route-mark);
  }

  .mark svg {
    display: block;
    inline-size: var(--route-mark);
    block-size: var(--route-mark);
    fill: var(--color-surface);
    stroke: var(--color-text-muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .amplifier .mark svg {
    stroke: var(--color-amber);
  }

  /* The stop the packet is at. */
  .stop[aria-current] .mark svg {
    stroke: var(--color-text);
    stroke-width: 2;
  }

  .text {
    grid-column: 3;
    display: grid;
    min-inline-size: 0;
  }

  .name {
    display: flex;
    align-items: center;
    min-block-size: var(--route-mark);
    font-weight: var(--weight-label);
    line-height: var(--leading-tight);
  }

  /* Each address has a line to itself, so none is ever broken in two. */
  .detail {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* The packet. It starts beside the first stop; the script sets how far down it has travelled, and CSS does the gliding. */
  .token {
    position: relative;
    z-index: 2;
    grid-column: 1;
    display: grid;
    justify-items: center;
    padding-block-start: calc((var(--route-mark) - var(--packet-height)) / 2);
    translate: 0 var(--packet-y, 0);
  }

  .layers {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    box-sizing: border-box;
    inline-size: var(--packet-width);
    block-size: var(--packet-height);
    overflow: hidden;
    border: var(--border-width) solid var(--color-text);
    border-radius: var(--radius-sm);
  }

  .layers span {
    background: var(--layer);
  }

  .token-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-label);
    line-height: var(--leading-tight);
  }

  .bar {
    display: grid;
    gap: var(--space-1);
  }

  .seg {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    border-block-start: var(--layer-edge) solid var(--layer);
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--layer) 12%, var(--color-surface));
    font-size: var(--text-sm);
  }

  /* At the server every header has been read and removed: struck through, with its colour drained. The text keeps its full contrast. */
  .seg[data-gone] {
    --layer: var(--color-border);
    text-decoration-line: line-through;
  }

  .label,
  .card h2 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: 0;
  }

  .v,
  .fval,
  .m {
    font-family: var(--font-mono);
    font-weight: var(--weight-label);
  }

  .v,
  .fval {
    padding-inline: var(--space-1);
    border-radius: var(--radius-sm);
  }

  /* A value this stop has just rewritten. It stays marked until the next step. */
  [data-changed] {
    background: var(--color-changed);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .controls button {
    padding: var(--space-2) var(--space-4);
    border: var(--border-width) solid var(--color-button-edge);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-weight: var(--weight-medium);
    cursor: pointer;
  }

  .controls .main {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .controls button[aria-disabled='true'] {
    opacity: 0.45;
    cursor: default;
  }

  .info {
    font-size: var(--text-sm);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
    gap: var(--space-3);
  }

  .card {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-block-start: var(--layer-edge) solid var(--layer);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .field {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
  }

  .fname,
  .note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .fval {
    font-size: var(--text-lg);
  }

  .note.strong {
    color: var(--color-text);
    font-weight: var(--weight-label);
  }

  /* `hidden` must win over the display values set above. */
  .packet [hidden] {
    display: none;
  }

  .changed,
  .verdict {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }

  .verdict {
    border: var(--border-width) solid var(--color-layer-ip);
  }

  .history-title {
    margin-block-start: var(--space-4);
    font-size: var(--text-lg);
  }

  table {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .table-scroll {
    overflow-x: auto;
  }

  th,
  td {
    padding: var(--space-2);
    border-block-end: var(--border-width) solid var(--color-border);
    text-align: start;
  }

  /* Addresses and column names stay whole; only the link's name may wrap. */
  th,
  .m {
    white-space: nowrap;
  }

  tr[data-current] td {
    background: var(--color-tint-c);
  }

  /* Without scripts the buttons cannot work: they go, and the table shows the whole journey. */
  @media (scripting: none) {
    .controls {
      display: none;
    }

    .packet tbody tr[hidden] {
      display: table-row;
    }
  }

  /* Movement, only for visitors who allow it. Without it, values simply change. */
  @media (prefers-reduced-motion: no-preference) {
    .token {
      transition: translate var(--duration-base) var(--ease-out);
    }

    /* A router replaces the Ethernet header: the old one leaves, the new one arrives. */
    .seg[data-swap] {
      animation: header-swap var(--duration-base) var(--ease-out);
    }

    [data-changed] {
      animation: value-pop var(--duration-base) var(--ease-out);
    }
  }

  @keyframes header-swap {
    0% {
      opacity: 1;
      translate: 0;
    }

    45% {
      opacity: 0;
      translate: calc(-1 * var(--space-6)) 0;
    }

    55% {
      opacity: 0;
      translate: var(--space-6) 0;
    }

    100% {
      opacity: 1;
      translate: 0;
    }
  }

  @keyframes value-pop {
    from {
      scale: 1.25;
    }
  }
</style>

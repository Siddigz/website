---
/*
 * Preview-only: lets the owner flip between the three looks built in stage 2.
 * Never rendered on the production site, and deleted once a look is chosen.
 */
import { DEFAULT_LOOK, LOOKS, LOOK_LABELS } from '../lib/look';

const onProduction = process.env.VERCEL_ENV === 'production';
---

{
  !onProduction && (
    <div class="look-switcher" role="group" aria-label="Preview look" data-look-switcher>
      <span class="title" aria-hidden="true">Look</span>
      {LOOKS.map((look) => (
        <button type="button" data-look-option={look} aria-pressed={look === DEFAULT_LOOK ? 'true' : 'false'}>
          {LOOK_LABELS[look]}
        </button>
      ))}
    </div>
  )
}

<style is:global>
  /* Room for the bar, so it never sits on top of the last line of the page. */
  body:has([data-look-switcher]) {
    padding-block-end: var(--switcher-space);
  }

  /* The bar keeps one plain style whichever look is showing. */
  .look-switcher {
    position: fixed;
    inset-block-end: var(--space-3);
    inset-inline: 0;
    z-index: var(--layer-switcher);
    display: flex;
    align-items: center;
    gap: var(--space-1);
    inline-size: fit-content;
    max-inline-size: calc(100% - var(--space-5));
    margin-inline: auto;
    padding: var(--space-1);
    border: var(--border-width) solid var(--color-switcher-border);
    border-radius: var(--radius-switcher);
    background: var(--color-switcher-bg);
    color: var(--color-switcher-text);
    font-family: var(--font-switcher);
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
    box-shadow: var(--shadow-switcher);
  }

  .look-switcher .title {
    padding-inline: var(--space-3) var(--space-2);
    color: var(--color-switcher-muted);
  }

  .look-switcher button {
    padding: var(--space-2) var(--space-3);
    border: 0;
    border-radius: var(--radius-switcher-button);
    background: transparent;
    color: inherit;
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .look-switcher button:hover {
    background: var(--color-switcher-hover);
  }

  .look-switcher button[aria-pressed='true'] {
    background: var(--color-switcher-text);
    color: var(--color-switcher-bg);
  }

  .look-switcher button:focus-visible {
    outline-color: var(--color-switcher-text);
  }
</style>

<script>
  import { LOOK_PARAM, LOOK_STORAGE_KEY, isLook, type Look } from '../lib/look';
  import { getStorage } from '../lib/theme';

  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-look-option]')];

  function show(look: Look) {
    root.dataset.look = look;
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.lookOption === look));
    }
  }

  // The head script has already applied the look; bring the buttons in step.
  if (isLook(root.dataset.look)) show(root.dataset.look);

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const look = button.dataset.lookOption;
      if (!isLook(look)) return;
      show(look);
      // A look named in the address would win again on reload, so keep it in step.
      const address = new URL(window.location.href);
      if (address.searchParams.has(LOOK_PARAM)) {
        address.searchParams.set(LOOK_PARAM, look);
        window.history.replaceState(window.history.state, '', address);
      }
      try {
        getStorage()?.setItem(LOOK_STORAGE_KEY, look);
      } catch {
        // The look still applies for this visit; it just is not remembered.
      }
    });
  }
</script>

---
// A button that fetches the contact address when pressed. The address is not
// in the page: it comes from the server, in exchange for a short-lived token.
import { getSite } from '../lib/site';

interface Props {
  /** `button` looks like the site's other buttons; `link` suits a row of plain links. */
  look?: 'button' | 'link';
}

const { look = 'button' } = Astro.props;
const { email } = await getSite();
---

<span class="email" data-email data-copy={email.copy} data-copied={email.copied} data-failed={email.failed}>
  <button type="button" class:list={[look === 'button' ? 'button' : 'plain']} data-email-reveal>{email.button}</button>
  {/*
    A small box that opens under the button, floating over the page so nothing moves.
    Once the address has arrived, the script puts a link to it here, above the Copy button.
    `hidden` keeps it away in a browser too old to open it this way; the script takes over from there.
  */}
  <span class="result" data-email-result popover="auto" hidden>
    <button type="button" class="copy" data-email-copy>{email.copy}</button>
    <span class="problem" data-email-problem hidden></span>
  </span>
  {/* Read out when something happens: a failure, or "Copied". What is shown is in the box and on the button. */}
  <span class="status" role="status" data-email-status></span>
</span>

<script>
  import '../scripts/email-reveal';
</script>

<style>
  .email {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  /* The buttons do nothing without scripts, so they are not offered. */
  @media (scripting: none) {
    .email {
      display: none;
    }
  }

  /* Looks like the plain links beside it. */
  .plain {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-accent);
    font-weight: inherit;
    text-decoration: underline;
    text-decoration-thickness: var(--indicator-width);
    text-underline-offset: var(--underline-offset);
    cursor: pointer;
  }

  /*
   * Once revealed: one small box in two halves, hanging under the button. The
   * address on top, and under it a Copy button exactly as wide. The script
   * says where the button is (--email-x, --email-y); the box floats over the
   * page there, so opening it moves nothing.
   */
  .result {
    position: absolute;
    inset: auto;
    inset-block-start: var(--email-y, 0);
    inset-inline-start: var(--email-x, 0);
    margin: 0;
    padding: 0;
    overflow: clip;
    max-inline-size: calc(100vw - 2 * var(--gutter));
    border: var(--border-width) solid var(--color-button-edge);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-card-hover);
  }

  /* Only while open: a closed box must stay out of the page. */
  .result:popover-open {
    display: inline-grid;
  }

  /* In a browser that cannot float it, the script shows it in line instead. */
  .result.in-line {
    position: static;
    box-shadow: none;
  }

  .result.in-line:not([hidden]) {
    display: inline-grid;
  }

  .result[hidden],
  .result [hidden] {
    display: none;
  }

  /* When the address could not be fetched, the box holds one line saying so. */
  .problem {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .result :global(a) {
    display: block;
    padding: var(--space-2) var(--space-4);
    color: var(--color-text);
    font-weight: var(--weight-bold);
    text-align: center;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .result :global(a:hover) {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }

  .copy {
    inline-size: 100%;
    padding: var(--space-2) var(--space-4);
    border: 0;
    border-block-start: var(--border-width) solid var(--color-button-edge);
    background: var(--color-tint-a);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    cursor: pointer;
  }

  .copy:hover {
    background: var(--color-tap);
  }

  /* Inside the box's rounded corners a ring drawn outside would be cut off, so it is drawn just inside. */
  .result :global(a:focus-visible),
  .copy:focus-visible {
    outline-offset: calc(-1 * var(--focus-width) - var(--border-width));
  }

  /*
   * Opening: the box pops in with a little spring, and the Copy half slides
   * down out from under the address. Only for visitors who allow motion.
   */
  @media (prefers-reduced-motion: no-preference) {
    .result:popover-open {
      animation: email-open var(--duration-base) var(--ease-spring);
    }

    .result:popover-open .copy {
      animation: email-copy-drop var(--duration-base) var(--ease-out);
    }

    /* The in-line kind gets the same, written apart so a browser that does not know the rules above still reads these. */
    .result.in-line:not([hidden]) {
      animation: email-open var(--duration-base) var(--ease-spring);
    }

    .result.in-line:not([hidden]) .copy {
      animation: email-copy-drop var(--duration-base) var(--ease-out);
    }
  }

  @keyframes email-open {
    from {
      opacity: 0;
      scale: var(--scale-pop-from);
    }
  }

  @keyframes email-copy-drop {
    from {
      opacity: 0;
      translate: 0 -100%;
    }
  }

  /* Only ever read out: what is shown is in the box and on the Copy button. */
  .status {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

---
// The name as two buttons, each playing a recording of its word. Used only
// while the sound is switched on (site.yaml: name.audio.enabled). The words
// stay plain text inside the page's one heading, so it still reads as the name.
// The hint they point to (`#name-audio-hint`) is placed by Hero, outside the heading.
import Speaker from './Speaker.astro';
import { getSite } from '../lib/site';

const site = await getSite();
const audio = site.nameAudio();
---

<button type="button" class="name-part" data-name-part="first" data-audio={audio.first} aria-describedby="name-audio-hint"><span data-name-text>{site.name.first}</span><Speaker /></button>{" "}<button type="button" class="name-part" data-name-part="last" data-audio={audio.last} aria-describedby="name-audio-hint"><span data-name-text>{site.name.last}</span><Speaker /></button>

<script>
  import '../scripts/name-audio';
</script>

<style>
  /* The two words of the name are buttons that look like the heading's text. */
  .name-part {
    position: relative;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    letter-spacing: inherit;
    white-space: nowrap;
    cursor: pointer;
  }

  /*
   * A small speaker perched on the top corner of the word, tipped up and to
   * the right as if calling out. Outside the text flow, so showing it moves nothing.
   */
  .name-part :global(svg) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    inline-size: var(--name-icon-size);
    block-size: var(--name-icon-size);
    translate: 30% -70%;
    rotate: var(--tilt-speaker);
    color: var(--color-accent);
    opacity: 0;
    pointer-events: none;
  }

  .name-part:hover :global(svg),
  .name-part:focus-visible :global(svg),
  .name-part[data-playing] :global(svg) {
    opacity: 1;
  }

  /*
   * While a word plays, its letters rise and fall one after another. The
   * script splits the word into letters only when motion is allowed, and
   * puts it back when the wave has passed.
   */
  @media (prefers-reduced-motion: no-preference) {
    /* It pops up with a little spring, and leans further while the word plays. */
    .name-part :global(svg) {
      scale: var(--scale-speaker-rest);
      transition:
        opacity var(--duration-fast) var(--ease-out),
        scale var(--duration-base) var(--ease-spring),
        rotate var(--duration-base) var(--ease-spring);
    }

    .name-part:hover :global(svg),
    .name-part:focus-visible :global(svg),
    .name-part[data-playing] :global(svg) {
      scale: 1;
    }

    .name-part[data-playing] :global(svg) {
      rotate: var(--tilt-speaker-playing);
    }

    .name-part :global([data-letter]) {
      display: inline-block;
      animation: letter-wave var(--duration-letter) var(--ease-out) both;
      /* The script numbers the letters where the browser cannot count them itself. */
      animation-delay: calc((var(--sibling-index) - 1) * var(--stagger-letter));
    }

    @supports (animation-delay: calc(sibling-index() * 0.1s)) {
      .name-part :global([data-letter]) {
        animation-delay: calc((sibling-index() - 1) * var(--stagger-letter));
      }
    }
  }

  @keyframes letter-wave {
    50% {
      color: var(--color-accent);
      translate: 0 calc(-1 * var(--lift-letter));
    }
  }
</style>

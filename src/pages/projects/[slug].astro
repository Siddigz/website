---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { featuredProjects, nextFeatured } from '../../lib/projects';
import { getSite } from '../../lib/site';

// Only featured projects get a page. The rest link straight to GitHub.
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return featuredProjects(projects).map((project) => ({
    params: { slug: project.id },
    props: { project, next: nextFeatured(projects, project.id) },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const site = await getSite();

/** The last part of a repository address: '…/cuRiding-Server' becomes 'cuRiding-Server'. */
const repoName = (url: string) => url.replace(/\/$/, '').split('/').pop() ?? url;
---

<BaseLayout title={`${data.title} · ${site.fullName}`} description={data.oneLiner} path={`/projects/${project.id}`} expect="project-top">
  <article class="project section container" data-project-slug={project.id}>
    <header id="project-top">
      <a class="back" href="/#projects"><span aria-hidden="true">←</span> Back to projects</a>
      {
        data.award && (
          <p class="award pill" data-award>
            {data.award.name} · {data.award.event}
          </p>
        )
      }
      <h1>{data.title}</h1>
      <p class="one-liner">{data.oneLiner}</p>
      <ul class="links" role="list">
        {data.links.repo && <li><a class="button" href={data.links.repo}>Repository</a></li>}
        {
          data.links.extraRepos?.map((url) => (
            <li>
              <a class="button" href={url} aria-label={`Repository: ${repoName(url)}`}>
                {repoName(url)}
              </a>
            </li>
          ))
        }
        {data.links.live && <li><a class="button" href={data.links.live}>Live app</a></li>}
        {data.links.video && <li><a class="button" href={data.links.video}>Watch demo</a></li>}
        {data.links.post && <li><a class="button" href={data.links.post}>LinkedIn post</a></li>}
      </ul>
      <ul class="stack muted" role="list" aria-label="Built with" translate="no">
        {data.stack.map((item) => <li class="pill">{item}</li>)}
      </ul>
    </header>

    <div class="body"><Content /></div>

    <div class="media">
      {data.cover && <Image class="lead" src={data.cover} alt={data.coverAlt ?? ''} width={1200} data-transition-image />}
      {data.gallery?.map((image) => <Image src={image.src} alt={image.alt} width={800} />)}
    </div>

    <footer>
      <a href="/#projects"><span aria-hidden="true">←</span> Back to projects</a>
      <a href={`/projects/${next.id}`}>Next: {next.data.title} <span aria-hidden="true">→</span></a>
    </footer>
  </article>
</BaseLayout>

<style>
  .project {
    display: grid;
    gap: var(--space-6);
  }

  header {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    max-inline-size: var(--measure);
  }

  h1 {
    overflow-wrap: anywhere;
    /* Where the browser animates between pages, the title travels to and from its card on the home page. */
    view-transition-name: project-title;
  }

  /* So does the lead picture. */
  .media :global(.lead) {
    view-transition-name: project-image;
  }

  .award {
    background: var(--color-tint-b);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .one-liner {
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .links,
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  .stack {
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
  }

  .body {
    display: grid;
    gap: var(--space-3);
    max-inline-size: var(--measure);
  }

  .body :global(h2) {
    margin-block-start: var(--space-4);
    font-size: var(--text-xl);
  }

  .back {
    font-weight: var(--weight-medium);
  }

  /* The cover runs full width; the other images sit two across on wide screens. */
  .media {
    display: grid;
    gap: var(--space-5);
    align-items: start;
    max-inline-size: var(--media-width);
  }

  @media (min-width: 48rem) {
    .media {
      grid-template-columns: 1fr 1fr;
    }

    .media :global(.lead),
    .media :global(img:only-child) {
      grid-column: 1 / -1;
    }
  }

  .media :global(img) {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-media);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
    font-weight: var(--weight-medium);
  }
</style>

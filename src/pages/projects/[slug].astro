---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { featuredProjects, nextFeatured } from '../../lib/projects';
import { getSite } from '../../lib/site';

// Only featured projects get a page. The rest link straight to GitHub.
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return featuredProjects(projects).map((project) => ({
    params: { slug: project.id },
    props: { project, next: nextFeatured(projects, project.id) },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const site = await getSite();

/** The last part of a repository address: '…/cuRiding-Server' becomes 'cuRiding-Server'. */
const repoName = (url: string) => url.replace(/\/$/, '').split('/').pop() ?? url;
---

<BaseLayout title={`${data.title} · ${site.fullName}`} description={data.oneLiner} path={`/projects/${project.id}`}>
  <article class="project section container">
    <header>
      <p><a href="/#projects">Back to projects</a></p>
      {
        data.award && (
          <p class="award" data-award>
            {data.award.name} · {data.award.event}
          </p>
        )
      }
      <h1>{data.title}</h1>
      <p class="one-liner">{data.oneLiner}</p>
      <ul class="links" role="list">
        <li><a class="button" href={data.links.repo}>Repository</a></li>
        {
          data.links.extraRepos?.map((url) => (
            <li>
              <a class="button" href={url} aria-label={`Repository: ${repoName(url)}`}>
                {repoName(url)}
              </a>
            </li>
          ))
        }
        {data.links.live && <li><a class="button" href={data.links.live}>Live app</a></li>}
        {data.links.video && <li><a class="button" href={data.links.video}>Watch demo</a></li>}
      </ul>
      <ul class="stack muted" role="list" aria-label="Built with">
        {data.stack.map((item) => <li>{item}</li>)}
      </ul>
    </header>

    <div class="body"><Content /></div>

    <div class="media">
      {
        data.cover && (
          <Image src={data.cover} alt={data.coverAlt ?? ''} width={1200} loading="eager" fetchpriority="high" />
        )
      }
      {data.gallery?.map((image) => <Image src={image.src} alt={image.alt} width={1200} />)}
    </div>

    <footer>
      <a href={`/projects/${next.id}`}>Next: {next.data.title}</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .project {
    display: grid;
    gap: var(--space-6);
  }

  header {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    max-inline-size: var(--measure);
  }

  h1 {
    overflow-wrap: anywhere;
  }

  .award {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
  }

  .one-liner {
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .links,
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  .stack {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .button {
    display: inline-flex;
    padding: var(--space-2) var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .button:hover {
    border-color: var(--color-accent);
  }

  .body {
    display: grid;
    gap: var(--space-3);
    max-inline-size: var(--measure);
  }

  .body :global(h2) {
    margin-block-start: var(--space-4);
    font-size: var(--text-xl);
  }

  .media {
    display: grid;
    gap: var(--space-5);
    max-inline-size: var(--media-width);
  }

  .media :global(img) {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  footer {
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
    font-weight: var(--weight-medium);
  }
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import SkillsStrip from '../components/SkillsStrip.astro';
import Experience from '../components/Experience.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { featuredProjects, moreProjects } from '../lib/projects';
import { getSite } from '../lib/site';
import { allowedRepos, loadActivity } from '../lib/github-activity';
import { ACTIVITY_FIXTURE, fixtures } from '../lib/build-env';

const site = await getSite();
const projects = await getCollection('projects');

// Fetched now, while the site is built. Null (no token, GitHub unreachable)
// leaves the section out; the rest of the page does not depend on it.
const activity = await loadActivity({
  token: process.env.GITHUB_ACTIVITY_TOKEN,
  login: new URL(site.links.github).pathname.replaceAll('/', ''),
  repos: allowedRepos(projects, site.repository),
  fixture: fixtures ? ACTIVITY_FIXTURE : undefined,
  // Three sit level with the year beside them.
  limit: 3,
});
---

<BaseLayout title={site.fullName} description={site.pitch} path="/">
  <Hero />
  <ProofStrip />
  <Experience />
  <SkillsStrip />

  <section id="projects" class="section container">
    <h2 class="section-title">Featured projects</h2>
    <div class="cards">
      {featuredProjects(projects).map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section id="more-projects" class="section container">
    <h2 class="section-title">More projects</h2>
    <ul class="rows" role="list">
      {moreProjects(projects).map((project) => <ProjectRow project={project} />)}
    </ul>
  </section>

  {activity && <GitHubActivity activity={activity} />}
  <About />
  <Contact />
</BaseLayout>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-5);
  }

  .rows {
    border-block-start: var(--border-width) solid var(--color-border);
  }
</style>

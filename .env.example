# Names of the private settings the site reads. Values never go in this file.
# Copy it to `.env` (git-ignored) for local work; the real ones live in Vercel.

# Read-only GitHub token for the activity section. Without it the section is left out.
GITHUB_ACTIVITY_TOKEN=

# The address the Email button reveals. Typed into the host by the owner; never committed.
CONTACT_ADDRESS=
# A long random value that signs the email reveal's short-lived tokens.
CONTACT_TOKEN_SECRET=

# The resume switch. Only the exact word "true" turns it on; leave empty for off.
RESUME_ENABLED=
# A private https address of the resume PDF, fetched by the server. Without it, a blank page is served.
RESUME_URL=
